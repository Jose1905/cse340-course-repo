  <%- include('partials/header') %>
  <main>
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
    <ul>
      <% projects.forEach((project) => { %>
        <% formattedDate = new Date(project.date).toLocaleDateString('en-US', {
          day: '2-digit',
          month: 'long',
          year: 'numeric'
        }) %>
        <li>
          <h3><%= formattedDate %>: <%= project.title %> (<%= project.name %>)</h3>
        </li>
      <% }); %>
    </ul>
  </main>
  <%- include('partials/footer') %>
