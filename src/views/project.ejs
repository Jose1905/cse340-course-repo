<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <p>
    <%= projectDetails.description %>
  </p>
  <p>Date: <%= new Date(projectDetails.date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
  }) %></p>
  <p>Location: <%= projectDetails.location %></p>
  <p>Organization: 
    <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a>
  </p>


  <h2>Categories:</h2>
  <ul>
    <% projectCategories.forEach((category) => { %>
      <li>
        <a href="/category/<%= category.category_id %>"><%= category.category_name %></a>
      </li>
    <% }); %>
  </ul>
</main>

<%- include('partials/footer') %>