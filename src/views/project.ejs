<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <p>
    <%= projectDetails.description %>
  </p>
  <p>Date: <%= new Date(projectDetails.date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
  }) %></p>
  <p>Location: <%= projectDetails.location %></p>
  <p>Organization: 
    <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a>
  </p>


  <h2>Categories:</h2>
  <ul>
    <% projectCategories.forEach((category) => { %>
      <li>
        <a href="/category/<%= category.category_id %>"><%= category.category_name %></a>
      </li>
    <% }); %>
  </ul>

  <% if (user) { %>
    <% if (isVolunteered) { %>
      <p>You are volunteering for this project.</p>
      <form action="/dashboard/<%= projectDetails.project_id %>/<%= isVolunteered %>" method="POST">
        <button type="submit">Remove Volunteer</button>
      </form>
    <% } else { %>
      <form action="/dashboard/<%= projectDetails.project_id %>/<%= isVolunteered %>" method="POST">
        <button type="submit">Volunteer</button>
      </form>
    <% } %>
  <% } %>


  <% if (user && user.role_name === 'admin') { %>
      <p><a href="/assign-categories/<%= projectDetails.project_id %>">Edit Categories %></a></p>

      <p><a href="/edit-project/<%= projectDetails.project_id %>">Edit Project %></a></p>
  <% } %>

</main>

<%- include('partials/footer') %>